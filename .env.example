# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Na Vercel, cadastre as mesmas variáveis em Project Settings → Environment Variables.
#
# Nunca coloque a service_role key no frontend. Use somente a chave pública (anon/publishable).
# Enquanto estas variáveis não estiverem preenchidas, o app funciona em modo local
# (dados salvos apenas no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON
